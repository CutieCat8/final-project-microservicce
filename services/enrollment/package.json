{
  "name": "registration-enrollment",
  "version": "0.1.0",
  "private": true,
  "description": "Enrollment API for the course registration demo",
  "engines": { "node": ">=24 <25" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "test": "npm run build && node --test tests/*.test.cjs",
    "test:unit": "npm run build && node --test tests/*.unit.test.cjs",
    "test:integration": "npm run build && node --test tests/*.integration.test.cjs"
  },
  "dependencies": { "express": "^5.1.0" },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.3"
  }
}
